<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark-mode theme: same as the base, but the status-bar background is dark,
         so its icons must be light (windowLightStatusBar = false). Colors resolve
         from values-night/colors.xml automatically. -->
    <style name="Theme.Scrollingo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
